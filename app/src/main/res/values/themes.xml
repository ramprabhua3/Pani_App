<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme — Compose screens override this entirely via PaniTheme.
         NoActionBar required so we don't show a system action bar below Compose's own. -->
    <style name="Theme.Pani" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
